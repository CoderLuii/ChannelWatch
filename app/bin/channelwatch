#!/venv/bin/python -I
"""Image-owned ChannelWatch operator CLI launcher."""

from __future__ import annotations

import os
import sys
from pathlib import Path


_IMAGE_APP_DIR = Path(os.environ.get("CHANNELWATCH_IMAGE_APP_DIR", "/app"))
_IMAGE_PYTHON = Path(os.environ.get("CHANNELWATCH_IMAGE_PYTHON", "/venv/bin/python"))
_DOCTOR_BOOTSTRAP = """
import runpy
import sys

image_app_dir = sys.argv.pop(1)
sys.path.insert(0, image_app_dir)
sys.argv = ["channelwatch doctor", *sys.argv[1:]]
runpy.run_module("core.cli.doctor", run_name="__main__")
""".strip()


def _required_image_path(path: Path, *, label: str, directory: bool) -> Path:
    invocation_path = path.absolute()
    try:
        resolved = invocation_path.resolve(strict=True)
    except OSError:
        raise RuntimeError(f"ChannelWatch {label} is unavailable: {path}") from None
    if directory and not resolved.is_dir():
        raise RuntimeError(f"ChannelWatch {label} is unavailable: {path}")
    if not directory and (not resolved.is_file() or not os.access(resolved, os.X_OK)):
        raise RuntimeError(f"ChannelWatch {label} is unavailable: {path}")
    return invocation_path


def _image_environment() -> dict[str, str]:
    return {
        name: value
        for name, value in os.environ.items()
        if not name.startswith("PYTHON")
        and name
        not in {
            "CHANNELWATCH_APP_DIR",
            "LD_AUDIT",
            "LD_LIBRARY_PATH",
            "LD_PRELOAD",
            "VIRTUAL_ENV",
        }
    }


def _run_doctor(arguments: list[str]) -> int:
    image_app_dir = _required_image_path(
        _IMAGE_APP_DIR, label="image application directory", directory=True
    )
    doctor_module = image_app_dir / "core" / "cli" / "doctor.py"
    if not doctor_module.is_file():
        raise RuntimeError(
            f"ChannelWatch image doctor module is unavailable: {doctor_module}"
        )
    image_python = _required_image_path(
        _IMAGE_PYTHON, label="image Python interpreter", directory=False
    )
    command = [
        str(image_python),
        "-I",
        "-B",
        "-c",
        _DOCTOR_BOOTSTRAP,
        str(image_app_dir),
        *arguments,
    ]
    os.chdir(image_app_dir)
    os.execve(str(image_python), command, _image_environment())
    return 1


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "doctor":
        try:
            return _run_doctor(sys.argv[2:])
        except RuntimeError as exc:
            print(str(exc), file=sys.stderr)
            return 1
        except OSError as exc:
            print(
                f"ChannelWatch image doctor launch failed: {exc.__class__.__name__}",
                file=sys.stderr,
            )
            return 1

    print("Usage: channelwatch doctor [ARGS...]", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
